{
  "name": "debateai",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "setup:client": "node scripts/sync-client-env.cjs",
    "check:env": "node scripts/check-env.cjs",
    "setup": "npm run setup:client && npm run db:push",
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "db:generate": "npm run db:generate --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:push": "npm run db:push --workspace=server",
    "db:up": "docker compose up -d"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
